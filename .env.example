# Server-side Gemini key. Never expose this as a VITE_ variable.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"
PORT="8787"

# Firebase project settings. API key is public client configuration, but is required server-side for token lookup.
FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
FIREBASE_PROJECT_ID="after-hours-3fba0"

# Resend email delivery. Configure only on the server / Cloud Run.
RESEND_API_KEY="YOUR_RESEND_API_KEY"
RESEND_FROM="AFTER HOURS <invites@your-verified-domain.com>"
APP_URL="https://minou-rz-qdpm3vdneq-ue.a.run.app"
